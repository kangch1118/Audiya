{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "login.html",
          "profile.html",
          "share.html",
          "callback.html",
          "styles.css",
          "app.js",
          "auth.js",
          "auth-app.js",
          "profile.js",
          "share.js",
          "theme.js",
          "audiya-logo.png"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
